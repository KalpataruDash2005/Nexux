# CareerOS React Frontend Environment Variables
# VITE_API_URL is reverse-proxied to the backend:
#  - Development: Vite proxies /api to http://localhost:8081
#  - Production:  Vercel builds point VITE_API_URL at the backend origin (Railway), e.g.
#                 VITE_API_URL=https://your-backend.up.railway.app/api/v1
# Keep it relative only when using the Vite module proxy (local dev).
VITE_API_URL=/api/v1
VITE_APP_NAME=CareerOS

# Full URL the "Continue with Google" button navigates to.
# Dev: leave empty (Vite proxies /oauth2/authorization to the backend).
# Prod: set to the backend origin, e.g. https://your-backend.up.railway.app/oauth2/authorization/google
VITE_OAUTH_AUTHORIZATION_URL=