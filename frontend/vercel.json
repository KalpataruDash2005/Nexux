{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|.*\\.(?:jpg|jpeg|png|webp|gif|svg|ico|mp4|webm|woff2|woff|ttf|json|txt|xml)).*)", "destination": "/index.html" }
  ]
}
