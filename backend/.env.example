# CareerOS Spring Boot Environment Variables Template
SPRING_PROFILES_ACTIVE=dev
# PostgreSQL (Supabase-compatible). Prefer DATABASE_URL when you have a connection string.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careeros_db
DB_USER=careeros_user
DB_PASSWORD=careeros_password_placeholder
JWT_SECRET=jwt_super_secret_key_minimum_256_bits_placeholder
JWT_EXPIRATION_MS=86400000

# --- SMTP (Gmail) for feedback + notification emails ---
# Use a Google "App Password" (16 chars), not your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Default Admin (created if no ADMIN user exists)
CAREEROS_ADMIN_EMAIL=admin@nexora.app
CAREEROS_ADMIN_PASSWORD=your-secure-password
