{
  "name": "CareerOS Academic Planner - Morning Focus",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Daily 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_URL}}/api/v1/planner/today",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.PLANNER_BACKEND_TOKEN}}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "Fetch Today's Focus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const focus = $input.first().json || {};\nconst items = (focus.focus || []);\nconst recs = (focus.recommendations || []);\n\nlet lines = ['Today's Focus (' + (focus.date || '') + ')'];\nfor (const item of items.slice(0, 3)) {\n  const when = item.daysRemaining === 0 ? 'Today' : item.daysRemaining === 1 ? 'Tomorrow' : (item.daysRemaining + ' days');\n  lines.push('- ' + item.title + ' [' + (item.priority || '') + '] - ' + when + ' - recommended ' + item.recommendedHours + 'h today');\n}\nif (recs.length) {\n  lines.push('Recommendations:');\n  for (const r of recs.slice(0, 3)) lines.push('* ' + r);\n}\nreturn [{ json: { message: lines.join('\\n'), items: items, recommendations: recs } }];\n"
      },
      "id": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
      "name": "Build Focus Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PLANNER_NOTIFY_WEBHOOK}}",
        "sendHeaders": false,
        "jsonBody": "={{ JSON.stringify({ title: 'Academic Planner - Today's Focus', message: $json.message }) }}",
        "options": {}
      },
      "id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Daily 7am": {
      "main": [
        [
          {
            "node": "Fetch Today's Focus",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Today's Focus": {
      "main": [
        [
          {
            "node": "Build Focus Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Focus Message": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "active": false,
  "tags": ["planner"]
}
