# ==============================================================================
# NEXAURA / CareerOS — Deployment Environment Template (Local MySQL + xAI Grok Routing)
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Option A: Local Development with MySQL (via Docker Compose)
DATABASE_URL=mysql+pymysql://careeros_user:careeros_pass@localhost:3306/careeros_db?charset=utf8mb4

# Discrete MySQL connection variables (used by docker-compose.yml and FastAPI auto-detection)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_USER=careeros_user
MYSQL_PASSWORD=careeros_pass
MYSQL_ROOT_PASSWORD=careeros_root_pass
MYSQL_DATABASE=careeros_db

# Option B: Cloud Serverless Database on Vercel (e.g. Supabase, Neon, Railway)
# Supabase Direct Connection (Session Mode):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Supabase Transaction Pooler (Serverless Pool Mode - recommended for Vercel):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 2. Supabase Object Storage (for persistent PDF files in Serverless)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key
# SUPABASE_STORAGE_BUCKET=documents

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Store (RAG Pipeline)
# ------------------------------------------------------------------------------
# Option A: Local Qdrant Container (via Docker Compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=careeros_pdf_chunks
QDRANT_USE_TLS=false
EMBEDDING_DIMENSION=384

# Option B: Qdrant Cloud Cluster (for Vercel serverless production)
# QDRANT_URL=https://your-qdrant-cluster.region.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ------------------------------------------------------------------------------
# 3. Authentication & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-64-character-hex-string-for-hmac-sha256-signing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. xAI Grok AI Provider & Workload Model Routing
# ------------------------------------------------------------------------------
XAI_API_BASE_URL=https://api.x.ai/v1

# Shared Fallback Key (used for all categories if specific category keys are omitted)
XAI_API_KEY=xai-your_shared_fallback_api_key_here

# Category-Specific API Keys (Optional: allow separate keys per workload)
XAI_API_KEY_PDF=xai-your_pdf_analysis_key_here
XAI_API_KEY_CHAT=xai-your_chat_key_here
XAI_API_KEY_RESUME=xai-your_resume_career_key_here
XAI_API_KEY_ASSESSMENT=xai-your_interview_assessment_key_here
XAI_API_KEY_GENERAL=xai-your_general_tasks_key_here

# Category-Specific Secondary/Backup Keys (Optional: bounded failover on 429 rate limits)
# XAI_BACKUP_API_KEY=xai-your_global_backup_key_here
# XAI_BACKUP_API_KEY_PDF=xai-your_pdf_backup_key_here
# XAI_BACKUP_API_KEY_CHAT=xai-your_chat_backup_key_here
# XAI_BACKUP_API_KEY_RESUME=xai-your_resume_backup_key_here
# XAI_BACKUP_API_KEY_ASSESSMENT=xai-your_assessment_backup_key_here
# XAI_BACKUP_API_KEY_GENERAL=xai-your_general_backup_key_here

# Workload Model Routing IDs (Configurable independently from API keys)
XAI_DEFAULT_MODEL=grok-2-mini
XAI_MODEL_PDF=grok-2-1212
XAI_MODEL_CHAT=grok-2-mini
XAI_MODEL_RESUME=grok-2-1212
XAI_MODEL_ASSESSMENT=grok-2-1212
XAI_MODEL_GENERAL=grok-2-mini

# Grok-Only Fallback Models (Within-workload fallback on server overload)
XAI_FALLBACK_MODEL=grok-beta
# XAI_FALLBACK_MODEL_PDF=grok-beta
# XAI_FALLBACK_MODEL_CHAT=grok-beta
# XAI_FALLBACK_MODEL_RESUME=grok-beta
# XAI_FALLBACK_MODEL_ASSESSMENT=grok-beta
# XAI_FALLBACK_MODEL_GENERAL=grok-beta

# Resilience & Timeouts
XAI_MAX_RETRIES=2
XAI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Admin Seed Credentials
# ------------------------------------------------------------------------------
CAREEROS_ADMIN_EMAIL=admin@nexora.app
CAREEROS_ADMIN_PASSWORD=SetSecureAdminPasswordHere!

# ------------------------------------------------------------------------------
# 6. CORS & Network
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://your-app.vercel.app
