# CareerOS root configuration variables template

# --- Database Setup ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=careeros_db
DB_USER=careeros_user
DB_PASSWORD=careeros_password_placeholder

# --- JWT Configuration ---
JWT_SECRET=jwt_super_secret_key_minimum_256_bits_placeholder
JWT_EXPIRATION_MS=86400000

# --- Port mappings ---
FRONTEND_PORT=3000
BACKEND_PORT=8081
N8N_PORT=5678

# --- AI API Keys ---
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_or_groq_api_key

# --- AI PDF Assistant (n8n) ---
PDF_ASSISTANT_STORAGE_DIR=./uploads/pdf-assistant
PDF_ASSISTANT_N8N_ENABLED=true
PDF_ASSISTANT_N8N_PROCESS_URL=http://localhost:5678/webhook/pdf-process
PDF_ASSISTANT_N8N_CHAT_URL=http://localhost:5678/webhook/pdf-chat
PDF_ASSISTANT_N8N_DELETE_URL=http://localhost:5678/webhook/pdf-delete
PDF_ASSISTANT_INTERNAL_KEY=careeros-pdf-internal-placeholder

# --- n8n PDF Assistant environment (consumed by the n8n container/workflows) ---
# Embeddings must be OpenAI-compatible. Use a 384-dim model/provider to match the
# backend native fallback collection (careeros_pdf_chunks, AllMiniLM-L6-v2). If you
# cannot provide 384-dim embeddings, set PDF_ASSISTANT_N8N_ENABLED=false instead.
N8N_EMBEDDING_BASE_URL=https://api.openai.com/v1
N8N_EMBEDDING_API_KEY=your_embedding_api_key
N8N_EMBEDDING_MODEL=text-embedding-3-small
N8N_LLM_BASE_URL=https://api.groq.com/openai/v1
N8N_LLM_API_KEY=your_llm_api_key
N8N_LLM_MODEL=llama-3.1-8b-instant
QDRANT_URL=http://localhost:6333
BACKEND_URL=http://localhost:8081
